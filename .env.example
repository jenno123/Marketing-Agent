# Supabase — find these in your Supabase project under Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase service role key — Settings > API > service_role (keep this secret!)
SUPABASE_SERVICE_KEY=sb_secret_...

# Anthropic API key — platform.anthropic.com/settings/keys (optional if set via the UI)
ANTHROPIC_API_KEY=sk-ant-api03-...
